# Notebook outputs are stripped at commit time everywhere...
*.ipynb filter=nbstrip

# ...EXCEPT the documentation tutorials, which are executed once on the full
# dataset and committed WITH their outputs, so the published site shows real
# figures without shipping the data. Do not add nbstrip here.
docs/source/tutorials/**/*.ipynb -filter
docs/source/tutorials/*.ipynb -filter

# The manuscript figure notebooks are executed once against the E3 ligase
# screen and committed WITH their outputs, so the published figures are
# visible without shipping the data. Same rationale as the tutorials above.
notebooks/manuscript_figures/*.ipynb -filter
