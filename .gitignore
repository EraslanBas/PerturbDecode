# ============================================================
# CODE AND CONFIGURATION ONLY -- no data files, ever.
# Strategy: ignore everything, then re-include known source types.
# Anything not listed below is excluded by default.
# ============================================================

# 1) Ignore everything...
*
# 2) ...but still descend into subdirectories
!*/

# ---- Code ----
!*.py
!*.pyx
!*.ipynb
!*.R
!*.r
!*.Rmd
!*.sh
!*.bash
!*.pl
!*.jl
!*.cpp
!*.c
!*.h
!*.hpp
!*.js
!*.sql
!*.smk
!Snakefile
!Makefile
!Dockerfile
!*.nf

# ---- Configuration ----
!*.yaml
!*.yml
!*.toml
!*.cfg
!*.ini
!*.conf
!*.json
!.gitignore
!.gitattributes
!.dockerignore
!environment.yml
!requirements*.txt
!setup.py
!setup.cfg
!pyproject.toml
!MANIFEST.in
!DESCRIPTION
!NAMESPACE

# ---- Web assets (documentation theme) ----
!*.css
!*.svg
!*.ico

# ---- Template files shipped with the example notebooks ----
# Exact paths only: CSVs are data by default and stay excluded.
!notebooks/large_screen/build_anndata/samples.csv

# Reference tables the replication notebooks read, and the small result tables
# they write. Narrow exception to the no-data rule above: these are what lets
# the analysis be rerun, and checked, from the screen object alone. Large
# objects still never enter the repository.
!notebooks/large_screen/build_anndata/TextFiles/*.csv
!notebooks/large_screen/build_anndata/TextFiles/*.csv.gz

# The combinatorial perturbation fits, 5 MB in all. Same narrow exception: they
# are what lets the Figure 5 notebooks run from a clone, and the twenty-five
# interaction splits among them cannot be regenerated at all, because the
# half-split in notebook 04 is unseeded.
!notebooks/large_screen/combinatorial_perturbations/RDSFiles/*.rds
# Small tables the figure notebooks read that no notebook here produces. Same
# narrow exception: without them nothing in manuscript_figures can be re-run.
!notebooks/large_screen/reference/*.csv
!notebooks/large_screen/reference/*.rds
# Cell-cycle gene list vendored because its upstream URL now 404s
!notebooks/large_screen/manuscript_figures/regev_lab_cell_cycle_genes.txt

# ---- Documentation figures ----
# Scoped to docs/ on purpose: raster images elsewhere in the repo are result
# figures and stay excluded by the allowlist.
!docs/source/_static/figures/**

# ---- Documentation ----
!*.md
!*.rst
!README*
!LICENSE*
!CITATION*

# ---- Re-exclude cruft that would otherwise slip through ----
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.virtual_documents/
wandb/
mlruns/
lightning_logs/

# ---- pre-existing project rules ----
# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
**/.ipynb_checkpoints/

# Virtual environment directories
env/
.venv/
venv/

# Pipenv / Poetry files
Pipfile.lock
poetry.lock

# Environment files (secrets only - do NOT blanket-ignore YAML:
# .readthedocs.yaml and .github/workflows/*.yml must stay tracked)
.env
*.env

# VS Code, PyCharm, and other IDE/editor settings
.vscode/
.idea/
*.swp

# Build artifacts (Python + Sphinx)
build/
dist/
*.egg-info/
*.egg
docs/_build/

# R / RStudio
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Logs and temporary files
*.log
*.tmp
*.bak

# OS-specific junk
.DS_Store
Thumbs.db

# Custom data/output folders.
#
# data/* rather than data/, so that data/README.md can be re-included below:
# git cannot re-include a file whose parent directory is excluded. Note the
# slash makes this one anchored to the repository root, where the bare data/
# it replaced matched a directory of that name at any depth. The directories
# that relied on that are named explicitly below.
data/*
output/
results/

# Raw per-channel input, named by par_data_dir. Large, and never committed.
notebooks/*/build_anndata/data/

# Allow a placeholder to be kept
!data/README.md


# ---- built documentation ----
/docs/_build/
